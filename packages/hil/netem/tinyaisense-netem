#!/usr/bin/env bash
# netem between this PC and one device, for the HIL tier's faults (packages/hil). It runs as root
# through a sudo rule for it alone (install.sh), so it takes only what it checks: an interface,
# an IPv4 address and a scenario by name.
#
#   tinyaisense-netem [--dry-run] apply <iface> <ipv4> <scenario>
#   tinyaisense-netem [--dry-run] clear <iface>
#
# apply shapes what goes to the device, on <iface>'s egress, and what comes from it, through an
# IFB on <iface>'s ingress, both with the scenario's netem; other traffic passes untouched. clear
# puts <iface> back as it was. --dry-run prints the commands instead of running them.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
IFB=tas-ifb

usage() {
  echo "usage: tinyaisense-netem [--dry-run] apply <iface> <ipv4> <scenario> | clear <iface>" >&2
  exit 2
}

netem() {
  case "$1" in
    loss2) echo "loss random 2%" ;;
    # 5% on average, in bursts of 4 on average: Gilbert-Elliott, every packet lost in the bad
    # state and none in the good one.
    loss5-bursts) echo "loss gemodel 1.32% 25% 100% 0%" ;;
    # Each packet 0 to 30 ms later, uniformly, and in order, as on one WiFi link and as the
    # Simulator's jitter: with a rate, netem sends no packet ahead of the one before it.
    jitter30) echo "delay 15ms 15ms rate 1gbit" ;;
    blackout) echo "loss random 100%" ;;
    *) echo "unknown scenario: $1" >&2; exit 2 ;;
  esac
}

dry=0
if [[ ${1-} == --dry-run ]]; then
  dry=1
  shift
fi
run() {
  if (( dry )); then echo "$*"; else "$@"; fi
}
# What may not be there to undo.
undo() {
  if (( dry )); then echo "$*"; else "$@" 2> /dev/null || true; fi
}

check_iface() {
  local re='^[A-Za-z0-9_.-]{1,15}$'
  if [[ ! $1 =~ $re || $1 == lo || $1 == "$IFB" || ! -e /sys/class/net/$1 ]]; then
    echo "not an interface to shape: $1" >&2
    exit 2
  fi
}

check_ip() {
  local re='^(0|[1-9][0-9]{0,2})(\.(0|[1-9][0-9]{0,2})){3}$' octet
  [[ $1 =~ $re ]] || not_ip "$1"
  for octet in ${1//./ }; do
    (( octet <= 255 )) || not_ip "$1"
  done
}

not_ip() {
  echo "not an IPv4 address: $1" >&2
  exit 2
}

clear_iface() {
  undo tc qdisc del dev "$1" root
  undo tc qdisc del dev "$1" ingress
  undo ip link del "$IFB"
}

case "${1-}" in
  apply)
    (( $# == 4 )) || usage
    iface=$2 ip=$3
    check_iface "$iface"
    check_ip "$ip"
    params=$(netem "$4")
    clear_iface "$iface"
    # Band 4 of a prio takes only what the filter puts there: the default priomap never does.
    run tc qdisc add dev "$iface" root handle 1: prio bands 4
    # shellcheck disable=SC2086 # the scenario's netem, from the table above
    run tc qdisc add dev "$iface" parent 1:4 handle 40: netem $params
    run tc filter add dev "$iface" parent 1: protocol ip prio 1 u32 match ip dst "$ip/32" flowid 1:4
    run ip link add "$IFB" type ifb
    run ip link set "$IFB" up
    run tc qdisc add dev "$iface" handle ffff: ingress
    run tc filter add dev "$iface" parent ffff: protocol ip prio 1 u32 match ip src "$ip/32" \
      action mirred egress redirect dev "$IFB"
    # shellcheck disable=SC2086
    run tc qdisc add dev "$IFB" root netem $params
    ;;
  clear)
    (( $# == 2 )) || usage
    check_iface "$2"
    clear_iface "$2"
    ;;
  *) usage ;;
esac
